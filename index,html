

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For My Shanze 🌻❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">

<style>
:root {
  --cream: #fff8df;
  --yellow: #ffce62;
  --gold: #c18a36;
  --brown: #684019;
  --soft: #f7e5b9;
  --white: #fffdf5;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--brown);
  background: var(--cream);
  font-family: 'Cormorant Garamond', serif;
  text-align: center;
}
button, a { -webkit-tap-highlight-color: transparent; }
button {
  cursor: pointer;
  font-family: 'Playfair Display', serif;
  color: var(--brown);
  border: 1px solid #e9b95b;
  border-radius: 40px;
  padding: 13px 28px;
  background: linear-gradient(135deg, #ffda7a, #ffc64c);
  font-size: 15px;
  transition: .25s;
}
button:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 20px #b9823026;
}
button.secondary {
  background: #fff8e6;
  border-color: #e8c994;
}
h1, h2, h3 {
  font-family: 'Playfair Display', serif;
  font-weight: 500;
}
h1 { font-size: clamp(35px, 7vw, 58px); margin: 10px 0; }
h2 { font-size: clamp(27px, 5vw, 39px); }
p { line-height: 1.65; }
section { padding: 65px 20px; }
.hidden { display: none !important; }
.eyebrow {
  font-size: 14px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #a47737;
}
.hero {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30px 20px;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 10% 15%, #ffe4a5 0, transparent 34%),
    radial-gradient(ellipse at 90% 85%, #f8dda0 0, transparent 35%),
    var(--cream);
}
.hero:before {
  content: "🌻  ✨  💛  🌼  ✨  🌻";
  position: absolute;
  top: 22px;
  left: 0;
  width: 100%;
  font-size: clamp(18px, 4vw, 30px);
  letter-spacing: 10px;
  opacity: .75;
}
.hero:after {
  content: "🌼  💛  🌻  ✨  🌼";
  position: absolute;
  bottom: 22px;
  left: 0;
  width: 100%;
  font-size: clamp(18px, 4vw, 30px);
  letter-spacing: 8px;
  opacity: .75;
}
.hero-content {
  position: relative;
  z-index: 1;
  max-width: 680px;
  width: 100%;
}
.sunflower { font-size: 75px; animation: sway 3s ease-in-out infinite; }
@keyframes sway {
  0%,100% { transform: rotate(-5deg); }
  50% { transform: rotate(5deg); }
}
.subtitle { font-size: 22px; font-style: italic; }
.buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}
.notice {
  margin: 22px auto 0;
  font-size: 21px;
  font-style: italic;
  min-height: 34px;
}
.panel {
  max-width: 820px;
  margin: 0 auto;
  padding: clamp(24px, 5vw, 48px);
  border: 1px solid #efd08d;
  border-radius: 25px;
  background: #fffdf3d9;
  box-shadow: 0 12px 35px #8b5d1710;
}
.panda { font-size: 65px; }
.small-note { font-size: 18px; font-style: italic; color: #98703c; }
.letter-section {
  background: linear-gradient(135deg, #fff9e7, #ffedbd);
}
.envelope {
  margin: 28px auto;
  width: min(100%, 340px);
  min-height: 180px;
  border: 2px solid #d5a34c;
  border-radius: 10px;
  background: linear-gradient(145deg, #fff4d4, #f1d391);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  box-shadow: 0 12px 25px #70481b20;
  cursor: pointer;
  transition: .35s;
  padding: 25px;
}
.envelope:hover { transform: translateY(-5px) rotate(-1deg); }
.envelope-icon { font-size: 65px; }
.envelope-label { font-size: 23px; }
.letter-paper {
  max-width: 740px;
  margin: 25px auto 0;
  padding: clamp(20px, 5vw, 40px);
  text-align: left;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.8;
  font-size: 19px;
  background: #fffdf5;
  border: 1px solid #f0d9a5;
  border-radius: 12px;
  box-shadow: 0 8px 24px #69471910;
}
.letter-paper p { margin: 0 0 18px; }
.song-section {
  background: #fffdf5;
}
.song-card {
  max-width: 580px;
  margin: 25px auto;
  padding: 30px 20px;
  border-radius: 24px;
  border: 1px solid #edcf8c;
  background: linear-gradient(145deg, #fff7dc, #ffebbc);
}
.album-art {
  width: 155px;
  height: 155px;
  margin: 20px auto;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 65px;
  background: radial-gradient(circle, #fff2b5, #f3c457);
  border: 5px solid #fff8e6;
  box-shadow: 0 8px 25px #a9762725;
}
.song-link { text-decoration: none; display: inline-block; margin-top: 18px; }
.proposal {
  min-height: 80vh;
  display: flex;
  align-items: center;
  background:
    radial-gradient(ellipse at bottom left, #ffe0a0, transparent 48%),
    radial-gradient(ellipse at top right, #ffeab7, transparent 45%),
    var(--cream);
}
.proposal .panel { width: 100%; }
.question { font-size: 27px; font-style: italic; }
#finalMessage {
  font-size: 25px;
  margin-top: 30px;
  line-height: 1.7;
}
footer { padding: 24px; font-size: 15px; color: #a17a42; }
.heart {
  position: fixed;
  pointer-events: none;
  z-index: 10;
  animation: floatUp 2.5s ease-out forwards;
}
@keyframes floatUp {
  from { transform: translateY(0) scale(.7); opacity: 1; }
  to { transform: translateY(-220px) scale(1.5); opacity: 0; }
}
@media (max-width: 520px) {
  section { padding: 45px 15px; }
  .subtitle { font-size: 20px; }
  .buttons button { min-width: 125px; }
  .letter-paper { font-size: 18px; }
}
</style>
</head>

<body>

<!-- SCREEN 1: THE FIRST QUESTION -->
<section class="hero" id="welcome">
  <div class="hero-content">
    <div class="sunflower">🌻</div>
    <div class="eyebrow">a little something for you</div>
    <h1>Hey baby... 💛</h1>
    <p class="subtitle">i have something to ask you...</p>
    <h2>do u wanna continue?</h2>

    <div class="buttons">
      <button onclick="goToLetter()">YES ❤️</button>
      <button class="secondary" onclick="firstNo()">NO 🙈</button>
    </div>

    <p class="notice" id="firstNotice"></p>
  </div>
</section>

<!-- SCREEN 2: THE LETTER -->
<section class="letter-section hidden" id="letterSection">
  <div class="panel">
    <div class="panda">🐼🌻</div>
    <div class="eyebrow">chapter one · just for you</div>
    <h2>A Letter I Never Sent 💌</h2>
    <p class="small-note">“i have so much left to tell you...”</p>

    <div class="envelope" id="envelope" onclick="openLetter()">
      <div class="envelope-icon">💌</div>
      <div class="envelope-label">open the envelope</div>
      <p class="small-note">tap here, baby ♡</p>
    </div>

    <div id="letterContent" class="hidden">
      <div class="letter-paper" id="letterText"></div>
      <p class="small-note">with all my heart, always. ❤️</p>
    </div>

    <div class="buttons">
      <button onclick="goToSong()">continue to our song 🎵</button>
    </div>
  </div>
</section>

<!-- SCREEN 3: AIQ SONG -->
<section class="song-section hidden" id="songSection">
  <div class="panel">
    <div class="panda">🐼🎶</div>
    <div class="eyebrow">chapter two · press play</div>
    <h2>a song for my girl 💛</h2>
    <p class="small-note">some songs say the things we can't.</p>

    <div class="song-card">
      <div class="album-art">🌻</div>
      <h2>AIQ 🎵</h2>
      <p class="subtitle">our song, our little world.</p>
      <p>close your eyes for a second and just listen, baby. ♡</p>

      <!-- Replace the link below with your actual AIQ song link -->
      <a class="song-link" href="https://www.youtube.com/results?search_query=AIQ+song"
         target="_blank" rel="noopener">
        <button>play our song ▶</button>
      </a>
    </div>

    <p class="small-note">“maybe we can start again, a little better this time.”</p>
    <div class="buttons">
      <button onclick="goToProposal()">there's one more thing... 💌</button>
    </div>
  </div>
</section>

<!-- SCREEN 4: THE PATCH-UP PROPOSAL -->
<section class="proposal hidden" id="proposalSection">
  <div class="panel">
    <div class="panda">🐼💛🐼</div>
    <div class="eyebrow">chapter three · one last question</div>
    <h2>Can We Try Again, Baby? 🥺❤️</h2>
    <p class="small-note">
      i don't want a perfect story.<br>
      i just want another chance to make ours better.
    </p>
    <p class="question">will you be my girl again? ❤️</p>

    <div class="buttons" id="proposalButtons">
      <button onclick="proposalYes()">YES 🥹❤️</button>
      <button class="secondary" onclick="proposalNo()">NO 🙈</button>
    </div>

    <p class="notice" id="proposalNotice"></p>
    <div id="finalMessage" class="hidden"></div>
  </div>
</section>

<footer>made with love, a little courage, and a whole lot of 🌻 for shanze. ❤️</footer>

<script>
/*
  YOUR LETTER IS SAVED RIGHT HERE.
  Change the words whenever you want.
  After you commit this file on GitHub, the letter will be there for visitors.
*/
const MY_LETTER = `goodmorning love ❤️ im actually shivering while writing this 😭 anwsss i just wanna say im sorry for my part in everything. ik i cant take back what happened and i wish i could, but i cant. all i can do is own up to my mistakes and try to make things right. i genuinely couldnt think of a better idea than this so yeah here goes nothing 😭

ik things havent been perfect on our end and we both have our own hurt, our complaints and things we wish were different, but i genuinely believe we can work through it. ik we both know eachother pretty well and i dont wanna believe that this is where our story ends. i miss you man, i miss having my girl around, i miss talking to you about random shit, annoying you, telling you everything and just having you there. i miss us shanze, like genuinely. and i dont think i realised how much until now.

i cant promise you that things will never get difficult again because obviously we're human and shit happens, but i can promise you that i dont wanna repeat the same mistakes and that ill actually try to make things better instead of just saying it. i want us to understand eachother better and not let things get to a point where we lose eachother again. i want to do better for you and for us, and i want you to feel like you can trust me and be comfortable with me. i know words are easy to say but pls let me show you as well.

shanze i want you man 😭❤️ i want my girl back. i wanna talk to you, laugh with you, annoy the shit out of you, listen to your rants and tell you all the random stuff that happens to me. i wanna have you as my person again. and ik we cant just pretend nothing happened but i really wanna try again and do things better this time. i dont wanna lose you over things we couldve worked through if we'd tried a little harder.

and bro im literally sitting here shivering while writing this so pls appreciate the effort 😭😭 ILL BE A GOODBOY I SWEAR. i just wanna skip to the part where i get to call you my girl again mannnn.

sooooo heyyyyy baby 👉🏻👈🏻 do you wanna choose us AGAIN???? 😭❤️

ik i cant speak for you but i really hope theres still a part of you that wants this too because i do. i wanna give us another chance and see where we can take this, without repeating the same things and with both of us actually trying.

youre genuinely one of the best people ik shanze and i still want you in my life. so pls pls pls will you be my girlfriend again???? 🥹❤️🌻

PLEASE SAY YES BABY ILL BE A GOODBOYYYY 😭❤️`;

document.getElementById("letterText").textContent = MY_LETTER;

function showSection(id) {
  ["welcome", "letterSection", "songSection", "proposalSection"].forEach(sectionId => {
    document.getElementById(sectionId).classList.add("hidden");
  });
  document.getElementById(id).classList.remove("hidden");
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function firstNo() {
  document.getElementById("firstNotice").textContent =
    "no is not an option 😭💗 please choose again, baby 🥺👉👈";
}

function goToLetter() {
  showSection("letterSection");
}

function openLetter() {
  document.getElementById("envelope").classList.add("hidden");
  document.getElementById("letterContent").classList.remove("hidden");
  document.getElementById("letterContent").scrollIntoView({ behavior: "smooth", block: "start" });
  burstHearts();
}

function goToSong() {
  showSection("songSection");
}

function goToProposal() {
  showSection("proposalSection");
}

function proposalNo() {
  document.getElementById("proposalNotice").textContent =
    "NO? 🥺 can i ask you to think about us one more time, baby? ❤️";
}

function proposalYes() {
  document.getElementById("proposalButtons").classList.add("hidden");
  document.getElementById("proposalNotice").classList.add("hidden");
  const final = document.getElementById("finalMessage");
  final.classList.remove("hidden");
  final.innerHTML =
    "BABYYYYYYYY 😭❤️🌻<br><br>" +
    "YOU SAID YESSSSSS 🥹💛<br><br>" +
    "thank you for giving us another chance, shanze. " +
    "i know we can't fix everything in one day, but i promise i'll keep trying " +
    "and show you through my actions how much you mean to me.<br><br>" +
    "come here, my girl 🫂💋<br>" +
    "I LOVE YOUUUUU ❤️🐼🌻";
  burstHearts();
  setInterval(burstHearts, 900);
}

function burstHearts() {
  const emojis = ["💛", "❤️", "🌻", "💗", "✨", "🥹"];
  for (let i = 0; i < 9; i++) {
    const heart = document.createElement("span");
    heart.className = "heart";
    heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    heart.style.left = Math.random() * 100 + "vw";
    heart.style.top = (55 + Math.random() * 35) + "vh";
    heart.style.fontSize = (18 + Math.random() * 20) + "px";
    document.body.appendChild(heart);
    setTimeout(() => heart.remove(), 2600);
  }
}
</script>
</body>
</html>
